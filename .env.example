# Public Supabase browser configuration.
# These are publishable values, never a secret/service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side copy used to verify bearer tokens in API routes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase admin key (sb_secret_... preferred).
# Required for irreversible account deletion. Never expose through VITE_*.
SUPABASE_SECRET_KEY=

# Optional global safety quotas. Account-specific limits in Supabase override these.
# Leave blank during development; configure before public beta.
OLYHUB_DAILY_REQUEST_LIMIT=
OLYHUB_DAILY_TOKEN_LIMIT=
OLYHUB_MONTHLY_TOKEN_LIMIT=

# AI providers. All keys are server-only.
# OpenAI is the required fallback provider.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
OPENAI_FALLBACK_MODEL=

# Optional direct / orchestration providers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GOOGLE_AI_API_KEY=
# GEMINI_API_KEY is accepted as a compatibility alias when GOOGLE_AI_API_KEY is unset.
GOOGLE_AI_MODEL=

ALLOWED_ORIGIN=
