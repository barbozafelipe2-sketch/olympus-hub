# Public Supabase browser configuration.
# These are publishable values, never a secret/service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side copy used to verify bearer tokens in API routes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase admin key (sb_secret_... preferred).
# Required for irreversible account deletion. Never expose through VITE_*.
SUPABASE_SECRET_KEY=

# Optional global safety quotas. Account-specific limits in Supabase override these.
# Leave blank during development; configure before public beta.
OLYHUB_DAILY_REQUEST_LIMIT=
OLYHUB_DAILY_TOKEN_LIMIT=
OLYHUB_MONTHLY_TOKEN_LIMIT=

# AI providers. All keys are server-only.
# Configure one or more providers for chat. Routing can fail over across healthy configured providers.
# OpenRouter is preferred for commercial execution; Gemini/OpenAI provide configured fallback. OpenAI also enables hosted web_search.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
OPENAI_FALLBACK_MODEL=
# Hosted Responses API web_search capability. Current default in code: gpt-5.5.
OPENAI_WEB_SEARCH_MODEL=

# Optional direct / orchestration providers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GOOGLE_AI_API_KEY=
# GEMINI_API_KEY is accepted as a compatibility alias when GOOGLE_AI_API_KEY is unset.
GOOGLE_AI_MODEL=

ALLOWED_ORIGIN=

# Commercial OlyHub transport (independent from Zeus Proxy and Netlify).
OPENROUTER_API_KEY=
OPENROUTER_ECONOMY_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_PREMIUM_MODEL=anthropic/claude-sonnet-4.5
# Optional additional trusted models: [{"model":"vendor/model","tier":"economy"}]
OPENROUTER_MODELS_JSON=[]
# Configure image models explicitly, with a conservative per-action USD bound.
# [{"provider":"openrouter","model":"vendor/image-model","estimatedUsd":0.20,"supportsReferences":true},...]
IMAGE_WORKFLOW_MODELS_JSON=[]
IMAGE_WORKFLOW_QUOTE_SECRET=
OLYHUB_WEB_MAX_COST_USD=

# Apple StoreKit subscriptions through RevenueCat; all three are SERVER ONLY.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_ALLOW_SANDBOX=false
# Map RevenueCat entitlement identifiers to explicit plan budgets. See docs/COMMERCIAL_ACTIVATION.md.
OLYHUB_SUBSCRIPTION_PLANS_JSON={}
